#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
build_dir="${repo_root}/build/preview-gap-sharpness-diagnostic"
binary="${build_dir}/bin/kdockw"
metadata_checker="${build_dir}/bin/kdockw_diagnostic_metadata_check"
desktop_template="${repo_root}/tools/kdockw-preview-sharpness-test.desktop"
desktop_file="${HOME}/.local/share/applications/kdockw-preview-sharpness-test.desktop"
config_file="${repo_root}/diagnostics/preview-gap-sharpness/config/kdockwrc"
log_file="${repo_root}/diagnostics/preview-gap-sharpness/logs/kdockw-wayland.log"
service="kdockw-preview-sharpness-test.service"

fail() {
    printf 'KDockW preview sharpness test refused: %s\n' "$1" >&2
    exit 1
}

[[ $# -le 2 ]] || fail "usage: $0 [auto|cpu-only] [baseline|linear]"
mode="${1:-cpu-only}"
[[ "$mode" == auto || "$mode" == cpu-only ]] || fail "capture mode must be auto or cpu-only"
filter_mode="${2:-baseline}"
[[ "$filter_mode" == baseline || "$filter_mode" == linear ]] || fail "filter mode must be baseline or linear"
filter_override=""
[[ "$filter_mode" == linear ]] && filter_override=linear
[[ -x "$binary" ]] || fail "diagnostic binary is missing or not executable: $binary"
[[ -x "$metadata_checker" ]] || fail "KService metadata checker is missing: $metadata_checker"
[[ -f "${build_dir}/CMakeCache.txt" ]] || fail "diagnostic CMake cache is missing"
grep -Fxq 'CMAKE_BUILD_TYPE:STRING=Release' "${build_dir}/CMakeCache.txt" \
    || fail "diagnostic candidate must use a Release build"
grep -Fxq 'KDOCKW_DIAGNOSTIC_BUILD:BOOL=ON' "${build_dir}/CMakeCache.txt" \
    || fail "test build must have KDOCKW_DIAGNOSTIC_BUILD=ON"
[[ -f "$desktop_template" ]] || fail "reviewed desktop entry is missing"

canonical_binary="$(readlink -f -- "$binary")"
grep -Fxq "Exec=${canonical_binary}" "$desktop_template" \
    || fail "desktop Exec does not equal the diagnostic binary's canonical path"
grep -Fxq 'X-KDE-Wayland-Interfaces=org_kde_plasma_window_management,zkde_screencast_unstable_v1' "$desktop_template" \
    || fail "desktop entry must request both KWin preview interfaces"
desktop-file-validate "$desktop_template" || fail "desktop entry validation failed"

manager_env="$(systemctl --user show-environment)" || fail "cannot read the Plasma user systemd environment"
for required in XDG_RUNTIME_DIR WAYLAND_DISPLAY DBUS_SESSION_BUS_ADDRESS XDG_CURRENT_DESKTOP KDE_SESSION_VERSION XDG_DATA_DIRS; do
    grep -q "^${required}=" <<<"$manager_env" || fail "user systemd manager lacks $required"
done
grep -Fxq "XDG_RUNTIME_DIR=/run/user/$(id -u)" <<<"$manager_env" || fail "manager runtime directory is not this user session"
grep -Fxq 'XDG_CURRENT_DESKTOP=KDE' <<<"$manager_env" || fail "manager is not in a KDE session"
grep -Fxq 'KDE_SESSION_VERSION=6' <<<"$manager_env" || fail "manager is not in Plasma 6"
wayland_display="$(sed -n 's/^WAYLAND_DISPLAY=//p' <<<"$manager_env")"
dbus_address="$(sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p' <<<"$manager_env")"
[[ -S "/run/user/$(id -u)/${wayland_display}" ]] || fail "user systemd Wayland socket is unavailable"
[[ "$dbus_address" == "unix:path=/run/user/$(id -u)/bus" && -S "/run/user/$(id -u)/bus" ]] \
    || fail "user systemd D-Bus address is not the active user bus"
for xdg_name in XDG_CONFIG_HOME XDG_CONFIG_DIRS XDG_DATA_HOME XDG_DATA_DIRS XDG_CACHE_HOME; do
    xdg_value="$(sed -n "s/^${xdg_name}=//p" <<<"$manager_env")"
    if [[ "$xdg_value" == *"${repo_root}/diagnostics"* || "$xdg_value" == *"/diagnostics/icon-rendering"* ]]; then
        fail "user systemd manager has a diagnostic XDG override in $xdg_name"
    fi
done
grep -Fxq 'KWIN_WAYLAND_NO_PERMISSION_CHECKS=1' <<<"$manager_env" \
    && fail "KWin permission checks are disabled in the user systemd manager"
if grep -Eq '^(KDOCKW_DIAGNOSTIC_CONFIG|KDOCKW_TASK_DIAGNOSTICS|KDOCKW_PREVIEW_CAPTURE_MODE|KDOCKW_PREVIEW_CLIP_TEST|KDOCKW_PREVIEW_SOURCE_TEST|KDOCKW_PREVIEW_SG_TRACE|KDOCKW_PREVIEW_METRICS|KDOCKW_PREVIEW_FILTER_TEST|QT_LOGGING_RULES|QT_LOGGING_CONF)=' <<<"$manager_env"; then
    fail "user systemd manager contains a pre-existing KDockW or Qt experiment variable"
fi

systemctl --user is-active --quiet "$service" && fail "$service is already active"
mapfile -t kdockw_pids < <(pgrep -x kdockw || true)
if ((${#kdockw_pids[@]})); then
    details=()
    for pid in "${kdockw_pids[@]}"; do
        details+=("${pid}:$(readlink -f "/proc/${pid}/exe" 2>/dev/null || printf 'unknown')")
    done
    fail "another KDockW instance is running (${details[*]}); close it normally and retry"
fi

if [[ -e "$desktop_file" ]]; then
    cmp -s "$desktop_template" "$desktop_file" \
        || fail "per-user KWin desktop entry already exists and differs: $desktop_file"
else
    install -D -m 0644 -- "$desktop_template" "$desktop_file"
fi
kbuildsycoca6
"$metadata_checker" "$canonical_binary" kdockw-preview-sharpness-test.desktop \
    || fail "KService did not resolve the diagnostic binary with both KWin interfaces"

mkdir -p "$(dirname -- "$config_file")" "$(dirname -- "$log_file")"
[[ -e "$config_file" ]] || install -m 0600 /dev/null "$config_file"
touch "$log_file"
systemd-run --user --no-block --collect --unit="$service" \
    --property=Type=exec \
    --property="StandardOutput=append:${log_file}" \
    --property="StandardError=append:${log_file}" \
    --setenv="KDOCKW_DIAGNOSTIC_CONFIG=${config_file}" \
    --setenv="KDOCKW_PREVIEW_CAPTURE_MODE=${mode}" \
    --setenv=KDOCKW_PREVIEW_CLIP_TEST=rounded \
    --setenv=KDOCKW_PREVIEW_SOURCE_TEST=pipewire \
    --setenv=KDOCKW_PREVIEW_SG_TRACE=1 \
    --setenv=KDOCKW_PREVIEW_METRICS=1 \
    --setenv="KDOCKW_PREVIEW_FILTER_TEST=${filter_override}" \
    "$binary"

printf 'Started %s: capture=%s, rounded PipeWire preview, filter=%s.\n' "$service" "$mode" "$filter_mode"
printf 'Binary: %s\nDesktop metadata: %s\nIsolated settings: %s\nLog: %s\n' \
    "$canonical_binary" "$desktop_file" "$config_file" "$log_file"
