#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
build_dir="${repo_root}/build/v041-spring-reentry-trace-diagnostic"
test_binary="$(readlink -f -- "${build_dir}/bin/kdockw")"
desktop_file="${HOME}/.local/share/applications/com.thicking.kdockw.desktop"
state_dir="${repo_root}/diagnostics/v041-spring-reentry-trace/launcher-state"
desktop_candidate="${state_dir}/candidate.desktop"
desktop_backup="${state_dir}/desktop-entry-backup"
desktop_was_absent="${state_dir}/desktop-entry-was-absent"
external_desktop_saved="${state_dir}/desktop-entry-edited-during-test"
state_file="${state_dir}/restore-state"
service="kdockw-v041-spring-reentry-trace.service"

fail() { printf 'KDockW Spring re-entry restore refused: %s\n' "$1" >&2; exit 1; }

[[ -f "$state_file" ]] || fail "no Spring re-entry restore state is recorded"
[[ "$(<"$state_file")" == "$test_binary" ]] || fail "restore state does not match this candidate binary"
[[ -f "$desktop_candidate" ]] || fail "generated desktop entry is missing; refusing to overwrite the user entry"

if systemctl --user is-active --quiet "$service"; then
    main_pid="$(systemctl --user show "$service" -p MainPID --value)"
    [[ "$main_pid" =~ ^[1-9][0-9]*$ ]] || fail "diagnostic service has no valid MainPID"
    [[ "$(readlink -f "/proc/${main_pid}/exe" 2>/dev/null || true)" == "$test_binary" ]] \
        || fail "active service is not running the expected candidate binary"
    systemctl --user stop "$service"
fi
for _ in {1..50}; do
    systemctl --user is-active --quiet "$service" || break
    sleep 0.1
done
systemctl --user is-active --quiet "$service" && fail "diagnostic service did not stop"

mapfile -t remaining_pids < <(pgrep -x kdockw || true)
for pid in "${remaining_pids[@]}"; do
    exe="$(readlink -f "/proc/${pid}/exe" 2>/dev/null || true)"
    [[ "$exe" != "$test_binary" ]] || fail "diagnostic candidate remains running outside its service; preserving restore records"
done

if [[ -f "$desktop_backup" ]]; then
    if [[ -e "$desktop_file" ]] && ! cmp -s "$desktop_candidate" "$desktop_file" \
            && ! cmp -s "$desktop_backup" "$desktop_file"; then
        [[ ! -e "$external_desktop_saved" ]] || fail "a concurrent desktop edit is already preserved at $external_desktop_saved"
        cp -p -- "$desktop_file" "$external_desktop_saved"
    fi
    install -D -m "$(stat -c '%a' "$desktop_backup")" "$desktop_backup" "$desktop_file"
elif [[ -f "$desktop_was_absent" ]]; then
    if [[ -e "$desktop_file" ]] && ! cmp -s "$desktop_candidate" "$desktop_file"; then
        [[ ! -e "$external_desktop_saved" ]] || fail "a concurrent desktop edit is already preserved at $external_desktop_saved"
        cp -p -- "$desktop_file" "$external_desktop_saved"
    fi
    [[ ! -e "$desktop_file" ]] || rm -f -- "$desktop_file"
else
    fail "desktop-entry backup is missing"
fi

rm -f -- "$desktop_backup" "$desktop_was_absent" "$desktop_candidate" "$state_file"
kbuildsycoca6
printf 'Stopped the diagnostic candidate and restored the previous per-user Desktop ID entry. No KDockW process was started.\n'
[[ ! -e "$external_desktop_saved" ]] || printf 'A concurrent desktop-entry edit was preserved at %s\n' "$external_desktop_saved"
