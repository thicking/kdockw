#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
build_dir="${repo_root}/build/v041-spring-reentry-trace-diagnostic"
binary="${build_dir}/bin/kdockw"
metadata_checker="${build_dir}/bin/kdockw_diagnostic_metadata_check"
ru_catalog="${build_dir}/src/locale/ru/LC_MESSAGES/kdockw.mo"
desktop_file="${HOME}/.local/share/applications/com.thicking.kdockw.desktop"
state_dir="${repo_root}/diagnostics/v041-spring-reentry-trace/launcher-state"
desktop_candidate="${state_dir}/candidate.desktop"
desktop_backup="${state_dir}/desktop-entry-backup"
desktop_was_absent="${state_dir}/desktop-entry-was-absent"
external_desktop_saved="${state_dir}/desktop-entry-edited-during-test"
state_file="${state_dir}/restore-state"
config_file="${repo_root}/diagnostics/v041-spring-reentry-trace/config/kdockwrc"
log_file="${repo_root}/diagnostics/v041-spring-reentry-trace/logs/kdockw.log"
service="kdockw-v041-spring-reentry-trace.service"

fail() { printf 'KDockW Spring re-entry test refused: %s\n' "$1" >&2; exit 1; }

[[ -x "$binary" ]] || fail "Release diagnostic binary is missing: $binary"
[[ -x "$metadata_checker" ]] || fail "KService metadata checker is missing: $metadata_checker"
[[ -s "$ru_catalog" ]] || fail "Russian diagnostic translation catalog is missing: $ru_catalog"
[[ -f "${build_dir}/CMakeCache.txt" ]] || fail "CMake cache is missing"
grep -Fxq 'CMAKE_BUILD_TYPE:STRING=Release' "${build_dir}/CMakeCache.txt" || fail "candidate must be Release"
grep -Fxq 'KDOCKW_DIAGNOSTIC_BUILD:BOOL=ON' "${build_dir}/CMakeCache.txt" || fail "candidate must use KDOCKW_DIAGNOSTIC_BUILD=ON"
canonical_binary="$(readlink -f -- "$binary")"
[[ "$canonical_binary" != *' '* ]] || fail "binary path contains spaces unsupported by Desktop Exec"

manager_env="$(systemctl --user show-environment)" || fail "cannot read Plasma user-manager environment"
for required in XDG_RUNTIME_DIR WAYLAND_DISPLAY DBUS_SESSION_BUS_ADDRESS XDG_CURRENT_DESKTOP KDE_SESSION_VERSION XDG_DATA_DIRS; do
    grep -q "^${required}=" <<<"$manager_env" || fail "user manager lacks $required"
done
grep -Fxq "XDG_RUNTIME_DIR=/run/user/$(id -u)" <<<"$manager_env" || fail "manager runtime directory does not match this user"
grep -Fxq 'XDG_CURRENT_DESKTOP=KDE' <<<"$manager_env" || fail "manager is not in a KDE session"
grep -Fxq 'KDE_SESSION_VERSION=6' <<<"$manager_env" || fail "manager is not in Plasma 6"
wayland_display="$(sed -n 's/^WAYLAND_DISPLAY=//p' <<<"$manager_env")"
dbus_address="$(sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p' <<<"$manager_env")"
[[ -S "/run/user/$(id -u)/${wayland_display}" ]] || fail "Wayland socket is unavailable"
[[ "$dbus_address" == "unix:path=/run/user/$(id -u)/bus" && -S "/run/user/$(id -u)/bus" ]] || fail "user D-Bus is unavailable"
grep -Fxq 'KWIN_WAYLAND_NO_PERMISSION_CHECKS=1' <<<"$manager_env" && fail "KWin permission checks are disabled"
if grep -Eq '^(KDOCKW_DIAGNOSTIC_[^=]*|KDOCKW_TASK_DIAGNOSTICS|KDOCKW_PREVIEW_CAPTURE_MODE|QT_LOGGING_RULES|QT_LOGGING_CONF)=' <<<"$manager_env"; then
    fail "Plasma manager has a pre-existing diagnostic override"
fi
for xdg_name in XDG_CONFIG_HOME XDG_CONFIG_DIRS XDG_DATA_HOME XDG_CACHE_HOME; do
    xdg_value="$(sed -n "s/^${xdg_name}=//p" <<<"$manager_env")"
    [[ "$xdg_value" == *"${repo_root}/diagnostics"* ]] && fail "manager has a diagnostic override in $xdg_name"
done

systemctl --user is-active --quiet "$service" && fail "$service is already active"
prior_state_dir="${repo_root}/diagnostics/v041-spring-reentry/launcher-state"
prior_service="kdockw-v041-spring-reentry.service"
systemctl --user is-active --quiet "$prior_service" && fail "$prior_service is active; do not replace its Desktop ID"
for prior_marker in restore-state desktop-entry-backup desktop-entry-was-absent; do
    [[ ! -e "${prior_state_dir}/${prior_marker}" ]] || fail "previous Spring candidate still needs restoration; run tools/kdockw-v041-spring-reentry-stop-and-restore first"
done
[[ ! -e "$state_file" && ! -e "$desktop_backup" && ! -e "$desktop_was_absent" ]] || fail "a previous Spring re-entry override needs restoration first"
[[ ! -e "$external_desktop_saved" ]] || fail "a concurrent desktop-entry edit was preserved at $external_desktop_saved; review it first"
mapfile -t running_pids < <(pgrep -x kdockw || true)
((${#running_pids[@]} == 0)) || fail "a KDockW process is already running (PIDs: ${running_pids[*]}); close it normally before launch"

mkdir -p "$state_dir" "$(dirname -- "$config_file")" "$(dirname -- "$log_file")"
[[ ! -e "$desktop_candidate" ]] || fail "a stale generated desktop entry needs review"
[[ ! -e "$desktop_file" || -f "$desktop_file" ]] || fail "user desktop entry is not a regular file"
if [[ -e "$desktop_file" ]]; then
    cp -p -- "$desktop_file" "$desktop_backup"
else
    : > "$desktop_was_absent"
fi
printf '%s\n' "$canonical_binary" > "$state_file"

restore_desktop_entry() {
    if [[ -f "$desktop_backup" ]]; then
        if [[ -e "$desktop_file" ]] && ! cmp -s "$desktop_candidate" "$desktop_file" \
                && ! cmp -s "$desktop_backup" "$desktop_file"; then
            [[ ! -e "$external_desktop_saved" ]] || fail "a previous concurrent desktop edit is already preserved at $external_desktop_saved"
            cp -p -- "$desktop_file" "$external_desktop_saved"
        fi
        install -D -m "$(stat -c '%a' "$desktop_backup")" "$desktop_backup" "$desktop_file"
    elif [[ -f "$desktop_was_absent" ]]; then
        if [[ -e "$desktop_file" ]] && ! cmp -s "$desktop_candidate" "$desktop_file"; then
            [[ ! -e "$external_desktop_saved" ]] || fail "a previous concurrent desktop edit is already preserved at $external_desktop_saved"
            cp -p -- "$desktop_file" "$external_desktop_saved"
        fi
        [[ ! -e "$desktop_file" ]] || rm -f -- "$desktop_file"
    else
        fail "desktop-entry restore record is missing"
    fi
    rm -f -- "$desktop_backup" "$desktop_was_absent" "$desktop_candidate" "$state_file"
    kbuildsycoca6 >/dev/null
}

cleanup_failed_start() {
    result=$?
    trap - EXIT
    if ((result != 0)); then
        if systemctl --user is-active --quiet "$service"; then
            main_pid="$(systemctl --user show "$service" -p MainPID --value 2>/dev/null || true)"
            if [[ "$main_pid" =~ ^[1-9][0-9]*$ ]] && [[ "$(readlink -f "/proc/${main_pid}/exe" 2>/dev/null || true)" == "$canonical_binary" ]]; then
                systemctl --user stop "$service" || true
            else
                printf 'Service identity is uncertain; restore records remain in %s\n' "$state_dir" >&2
                exit "$result"
            fi
        fi
        if ! systemctl --user is-active --quiet "$service"; then
            restore_desktop_entry || printf 'Automatic restore failed; run %s/tools/kdockw-v041-spring-reentry-trace-stop-and-restore\n' "$repo_root" >&2
        fi
    fi
    exit "$result"
}
trap cleanup_failed_start EXIT

cat > "$desktop_candidate" <<EOF
[Desktop Entry]
Type=Application
Name=KDockW v0.4.1 Spring Re-entry Trace Test
NoDisplay=false
Terminal=false
Exec=${canonical_binary}
Icon=com.thicking.kdockw
X-KDE-Wayland-Interfaces=org_kde_plasma_window_management,zkde_screencast_unstable_v1
EOF
chmod 0644 "$desktop_candidate"
desktop-file-validate "$desktop_candidate" || fail "generated desktop entry is invalid"
grep -Fxq "Exec=${canonical_binary}" "$desktop_candidate" || fail "desktop Exec does not match candidate binary"
install -D -m 0644 -- "$desktop_candidate" "$desktop_file"
kbuildsycoca6
"$metadata_checker" "$canonical_binary" com.thicking.kdockw.desktop \
    || fail "KService did not resolve Desktop ID com.thicking.kdockw with candidate Exec and KWin interfaces"

touch "$config_file" "$log_file"
systemd-run --user --no-block --collect --unit="$service" \
    --property=Type=exec \
    --property="StandardOutput=append:${log_file}" \
    --property="StandardError=append:${log_file}" \
    --setenv="KDOCKW_DIAGNOSTIC_CONFIG=${config_file}" \
    --setenv=KDOCKW_TASK_DIAGNOSTICS=1 \
    --setenv=KDOCKW_PREVIEW_CAPTURE_MODE=cpu-only \
    "$binary"

started=false
for _ in {1..50}; do
    if systemctl --user is-active --quiet "$service"; then
        main_pid="$(systemctl --user show "$service" -p MainPID --value 2>/dev/null || true)"
        if [[ "$main_pid" =~ ^[1-9][0-9]*$ ]] && [[ "$(readlink -f "/proc/${main_pid}/exe" 2>/dev/null || true)" == "$canonical_binary" ]]; then
            started=true
            break
        fi
    fi
    sleep 0.1
done
[[ "$started" == true ]] || fail "diagnostic service did not become active with the expected executable"
trap - EXIT

printf 'Started %s\nBinary: %s\nRuntime Desktop ID: com.thicking.kdockw\nPreview capture: CPU-only\nSeparate settings: %s\nTask diagnostics: enabled\nLog: %s\n' \
    "$service" "$canonical_binary" "$config_file" "$log_file"
printf 'After visual testing, run: %s/tools/kdockw-v041-spring-reentry-trace-stop-and-restore\n' "$repo_root"
