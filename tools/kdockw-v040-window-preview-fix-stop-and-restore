#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
test_binary="$(readlink -f -- "${repo_root}/build/v040-window-preview-fix/bin/kdockw")"
installed_binary="/usr/bin/kdockw"
desktop_file="${HOME}/.local/share/applications/com.thicking.kdockw.desktop"
state_dir="${repo_root}/diagnostics/v040-window-preview-fix/launcher-state"
desktop_candidate="${state_dir}/candidate.desktop"
desktop_backup="${state_dir}/desktop-entry-backup"
desktop_was_absent="${state_dir}/desktop-entry-was-absent"
external_desktop_saved="${state_dir}/desktop-entry-edited-during-test"
state_file="${state_dir}/restore-state"
test_service="kdockw-v040-window-preview-fix.service"
restore_service="kdockw-v040-window-preview-fix-installed.service"

fail() { printf 'KDockW window-preview-fix restore refused: %s\n' "$1" >&2; exit 1; }

[[ -f "$state_file" ]] || fail "no window-preview-fix restore state is recorded"
[[ "$(<"$state_file")" == "$test_binary" ]] || fail "restore state does not match this candidate binary"
[[ -f "$desktop_candidate" ]] || fail "generated desktop entry is missing; refusing to overwrite the user entry"

if systemctl --user is-active --quiet "$test_service"; then
    main_pid="$(systemctl --user show "$test_service" -p MainPID --value)"
    [[ "$main_pid" =~ ^[1-9][0-9]*$ ]] || fail "diagnostic service has no valid MainPID"
    [[ "$(readlink -f "/proc/${main_pid}/exe" 2>/dev/null || true)" == "$test_binary" ]] \
        || fail "active service is not running the expected candidate binary"
    systemctl --user stop "$test_service"
fi
for _ in {1..50}; do
    systemctl --user is-active --quiet "$test_service" || break
    sleep 0.1
done
systemctl --user is-active --quiet "$test_service" && fail "diagnostic service did not stop"

mapfile -t remaining_pids < <(pgrep -x kdockw || true)
for pid in "${remaining_pids[@]}"; do
    exe="$(readlink -f "/proc/${pid}/exe" 2>/dev/null || true)"
    [[ "$exe" != "$test_binary" ]] || fail "diagnostic candidate remains running outside its service; refusing to restore metadata yet"
    [[ "$exe" == "$installed_binary" ]] || fail "unexpected KDockW process remains (${pid}:${exe:-unknown})"
done

if [[ -f "$desktop_backup" ]]; then
    if [[ -e "$desktop_file" ]] && ! cmp -s "$desktop_candidate" "$desktop_file" \
            && ! cmp -s "$desktop_backup" "$desktop_file"; then
        [[ ! -e "$external_desktop_saved" ]] || fail "an earlier concurrent desktop edit is already preserved at $external_desktop_saved"
        cp -p -- "$desktop_file" "$external_desktop_saved"
    fi
    install -D -m "$(stat -c '%a' "$desktop_backup")" "$desktop_backup" "$desktop_file"
elif [[ -f "$desktop_was_absent" ]]; then
    if [[ -e "$desktop_file" ]] && ! cmp -s "$desktop_candidate" "$desktop_file"; then
        [[ ! -e "$external_desktop_saved" ]] || fail "an earlier concurrent desktop edit is already preserved at $external_desktop_saved"
        cp -p -- "$desktop_file" "$external_desktop_saved"
    fi
    [[ ! -e "$desktop_file" ]] || rm -f -- "$desktop_file"
else
    fail "desktop-entry backup record is missing"
fi
rm -f -- "$desktop_backup" "$desktop_was_absent" "$desktop_candidate" "$state_file"
kbuildsycoca6
[[ ! -e "$external_desktop_saved" ]] || printf 'Preserved a concurrent desktop-entry edit at %s\n' "$external_desktop_saved"

mapfile -t running_pids < <(pgrep -x kdockw || true)
if ((${#running_pids[@]})); then
    for pid in "${running_pids[@]}"; do
        exe="$(readlink -f "/proc/${pid}/exe" 2>/dev/null || true)"
        [[ "$exe" == "$installed_binary" ]] || fail "unexpected KDockW process remains (${pid}:${exe:-unknown}); will not start another instance"
    done
    printf 'Restored the original desktop entry. Installed KDockW is already running and was left untouched.\n'
    exit 0
fi

[[ -x "$installed_binary" ]] || fail "installed KDockW is missing: $installed_binary"
command -v dpkg-query >/dev/null || fail "dpkg-query is unavailable; desktop entry restored, but installed version was not verified"
package_record="$(dpkg-query -S "$installed_binary" 2>/dev/null | head -n 1 || true)"
package_name="${package_record%%: *}"
[[ -n "$package_name" && "$package_name" != "$package_record" ]] || fail "could not identify the package owning $installed_binary"
package_version="$(dpkg-query -W -f='${Version}' "$package_name" 2>/dev/null || true)"
[[ "$package_version" =~ ^([0-9]+:)?0\.3\.1(-|$) ]] \
    || fail "installed package version is not KDockW 0.3.1 (desktop entry was restored)"
systemctl --user is-active --quiet "$restore_service" && fail "$restore_service is already active"
systemd-run --user --no-block --collect --unit="$restore_service" --property=Type=exec "$installed_binary"
restored=false
for _ in {1..50}; do
    if systemctl --user is-active --quiet "$restore_service"; then
        main_pid="$(systemctl --user show "$restore_service" -p MainPID --value 2>/dev/null || true)"
        if [[ "$main_pid" =~ ^[1-9][0-9]*$ ]] && [[ "$(readlink -f "/proc/${main_pid}/exe" 2>/dev/null || true)" == "$installed_binary" ]]; then
            restored=true
            break
        fi
    fi
    sleep 0.1
done
[[ "$restored" == true ]] || fail "installed KDockW 0.3.1 did not become active; the original desktop entry is restored"
printf 'Restored the original desktop entry and started installed KDockW %s: %s\n' "$package_version" "$installed_binary"
