if(NOT DEFINED SOURCE_DIR OR NOT DEFINED KDOCKW_VERSION)
    message(FATAL_ERROR "SOURCE_DIR and KDOCKW_VERSION are required")
endif()

string(REGEX MATCH "^[0-9]+\\.[0-9]+\\.[0-9]+" version_core "${KDOCKW_VERSION}")
if(NOT version_core)
    message(FATAL_ERROR "KDOCKW_VERSION has no numeric SemVer core: ${KDOCKW_VERSION}")
endif()
string(REPLACE "-" "_" arch_version "${KDOCKW_VERSION}")
string(REPLACE "-" "~" deb_upstream_version "${KDOCKW_VERSION}")

file(READ "${SOURCE_DIR}/src/com.thicking.kdockw.metainfo.xml" appstream)
file(READ "${SOURCE_DIR}/src/po/ru/kdockw.po" catalog)
file(READ "${SOURCE_DIR}/packaging/arch/PKGBUILD" arch)
file(READ "${SOURCE_DIR}/packaging/arch/.SRCINFO" arch_srcinfo)
file(READ "${SOURCE_DIR}/packaging/obs/kdockw.spec" rpm)
file(READ "${SOURCE_DIR}/packaging/obs/kdockw.dsc" debian_source)
file(READ "${SOURCE_DIR}/packaging/obs/debian.changelog" debian_changelog)

if(NOT appstream MATCHES "<release version=\"${KDOCKW_VERSION}\"[^>]*type=\"development\"")
    message(FATAL_ERROR "AppStream development release does not match KDOCKW_VERSION")
endif()
if(NOT catalog MATCHES "Project-Id-Version: KDockW ${KDOCKW_VERSION}")
    message(FATAL_ERROR "Translation catalog header does not match KDOCKW_VERSION")
endif()
if(NOT arch MATCHES "pkgver=${arch_version}")
    message(FATAL_ERROR "Arch pkgver does not match KDOCKW_VERSION")
endif()
if(NOT arch_srcinfo MATCHES "pkgver = ${arch_version}" OR NOT arch_srcinfo MATCHES "source = kdockw-${KDOCKW_VERSION}.tar.gz")
    message(FATAL_ERROR "Arch .SRCINFO does not match the development version")
endif()
if(NOT rpm MATCHES "Version:[ \t]*${version_core}" OR NOT rpm MATCHES "Release:[ \t]*0\\.dev")
    message(FATAL_ERROR "RPM Version/Release mapping does not match KDOCKW_VERSION")
endif()
if(NOT debian_source MATCHES "Version: ${deb_upstream_version}-1")
    message(FATAL_ERROR "Debian source version does not match KDOCKW_VERSION")
endif()
if(NOT debian_changelog MATCHES "^kdockw \\(${deb_upstream_version}-1\\)")
    message(FATAL_ERROR "Debian changelog version does not match KDOCKW_VERSION")
endif()

if(NOT debian_source MATCHES "DEBTRANSFORM-TAR: kdockw-${KDOCKW_VERSION}\\.tar\\.gz")
    message(FATAL_ERROR "Debian source archive name does not match KDOCKW_VERSION")
endif()
