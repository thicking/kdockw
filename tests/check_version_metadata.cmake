if(NOT DEFINED SOURCE_DIR OR NOT DEFINED KDOCKW_VERSION)
    message(FATAL_ERROR "SOURCE_DIR and KDOCKW_VERSION are required")
endif()

string(REGEX MATCH "^[0-9]+\\.[0-9]+\\.[0-9]+" version_core "${KDOCKW_VERSION}")
if(NOT version_core)
    message(FATAL_ERROR "KDOCKW_VERSION has no numeric SemVer core: ${KDOCKW_VERSION}")
endif()

file(READ "${SOURCE_DIR}/CMakeLists.txt" cmake_source)
string(REGEX MATCH "set\\(KDOCKW_VERSION \"([^\"]+)\"\\)" _ "${cmake_source}")
if(NOT CMAKE_MATCH_1 STREQUAL KDOCKW_VERSION)
    message(FATAL_ERROR "CMakeLists.txt version '${CMAKE_MATCH_1}' does not match ${KDOCKW_VERSION}")
endif()
if(NOT cmake_source MATCHES "KDOCKW_VERSION_STRING=\\\"\\$\\{KDOCKW_VERSION\\}\\\"")
    message(FATAL_ERROR "CMake does not pass KDOCKW_VERSION to the application")
endif()

file(READ "${SOURCE_DIR}/src/main.cpp" main_source)
file(READ "${SOURCE_DIR}/src/app/application.cpp" application_source)
if(NOT main_source MATCHES "setApplicationVersion\\(aboutData\\.version\\(\\)\\)"
   OR NOT application_source MATCHES "KDOCKW_VERSION_STRING")
    message(FATAL_ERROR "CLI/About version is not sourced from the canonical CMake version")
endif()

if(KDOCKW_VERSION MATCHES "-dev$")
    set(is_development TRUE)
    string(REPLACE "-dev" "~dev" package_version "${KDOCKW_VERSION}")
    set(debian_version "${package_version}-1")
else()
    set(is_development FALSE)
    set(package_version "${KDOCKW_VERSION}")
    set(debian_version "${KDOCKW_VERSION}-1")
endif()

file(READ "${SOURCE_DIR}/src/com.thicking.kdockw.metainfo.xml" appstream)
file(READ "${SOURCE_DIR}/src/po/ru/kdockw.po" catalog)
file(READ "${SOURCE_DIR}/packaging/obs/kdockw.spec" rpm)
file(READ "${SOURCE_DIR}/packaging/obs/kdockw.dsc" debian_source)
file(READ "${SOURCE_DIR}/packaging/obs/debian.changelog" debian_changelog)

if(is_development)
    if(NOT appstream MATCHES "<release version=\"${KDOCKW_VERSION}\"[^>]*type=\"development\"")
        message(FATAL_ERROR "AppStream development release does not match KDOCKW_VERSION")
    endif()
else()
    if(NOT appstream MATCHES "<release version=\"${KDOCKW_VERSION}\" date=\"[0-9-]+\">")
        message(FATAL_ERROR "AppStream stable release does not match KDOCKW_VERSION")
    endif()
endif()

if(NOT catalog MATCHES "Project-Id-Version: KDockW ${KDOCKW_VERSION}")
    message(FATAL_ERROR "Translation catalog header does not match KDOCKW_VERSION")
endif()
if(NOT rpm MATCHES "Version:[ \\t]*${package_version}" OR NOT rpm MATCHES "upstream_version ${KDOCKW_VERSION}")
    message(FATAL_ERROR "RPM Version/upstream_version do not match their expected package version")
endif()
if(NOT rpm MATCHES "%\\{_datadir\\}/locale/\\*/LC_MESSAGES/kdockw\\.mo")
    message(FATAL_ERROR "RPM package must include the KI18n catalog")
endif()
if(NOT debian_source MATCHES "Version: ${debian_version}" OR NOT debian_changelog MATCHES "^kdockw \\(${debian_version}\\)")
    message(FATAL_ERROR "Debian source/changelog versions do not match KDOCKW_VERSION")
endif()
if(NOT debian_source MATCHES "DEBTRANSFORM-TAR: kdockw-${KDOCKW_VERSION}\\.tar\\.gz")
    message(FATAL_ERROR "Debian source archive name does not match the canonical source version")
endif()

# The distro build harness must name/extract the source using the canonical
# CMake version, not package-manager-specific versions such as 0.1.0_pre or
# 0.1.0~dev. RPM Source0 uses the basename from its permanent tag URL.
file(READ "${SOURCE_DIR}/tests/distro/build-package.sh" distro_build)
file(READ "${SOURCE_DIR}/tests/distro/source-version.sh" source_version_helper)
file(READ "${SOURCE_DIR}/tests/distro/pkg/rpm-build.sh" rpm_build)
string(FIND "${distro_build}" "source_version \"\$repo_root/CMakeLists.txt\"" source_version_call)
if(source_version_call EQUAL -1 OR distro_build MATCHES "package_version")
    message(FATAL_ERROR "Distro build harness must use the canonical source_version")
endif()
if(NOT source_version_helper MATCHES "KDOCKW_VERSION" OR NOT source_version_helper MATCHES "awk")
    message(FATAL_ERROR "Distro source version must come from the root CMakeLists.txt")
endif()
if(NOT rpm MATCHES "Source0:[ \\t]*https://github\\.com/.*/archive/refs/tags/kdockw-v%\\{upstream_version\\}\\.tar\\.gz")
    message(FATAL_ERROR "RPM Source0 archive basename must follow the permanent tag URL")
endif()
if(NOT rpm_build MATCHES "SOURCES/kdockw-v\\$\\{KDOCKW_VERSION\\}\\.tar\\.gz")
    message(FATAL_ERROR "RPM source archive basename must match the spec Source0 URL")
endif()
