[Desktop Entry]
Type=Application
Name=KDockW
Name[ru]=KDockW
Comment=Start KDockW dock automatically at login
Comment[ru]=Автоматически запускать док KDockW при входе в систему
Exec=@KDE_INSTALL_FULL_BINDIR@/kdockw
Icon=com.thicking.kdockw
Terminal=false
OnlyShowIn=KDE;
X-GNOME-Autostart-enabled=true
