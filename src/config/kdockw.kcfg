<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name="kdockwrc"/>

  <group name="General">
    <entry name="CheckForUpdatesAutomatically" type="Bool">
      <label>Check for updates automatically</label>
      <default>true</default>
    </entry>

    <entry name="NotifyAboutUpdates" type="Bool">
      <label>Notify about new versions</label>
      <default>true</default>
    </entry>

    <entry name="LastSuccessfulUpdateCheck" type="String">
      <label>Time of the last successful update check</label>
      <default></default>
    </entry>

    <entry name="LastAutomaticUpdateAttempt" type="String">
      <label>Time of the last automatic update check attempt</label>
      <default></default>
    </entry>

    <entry name="ReleasesApiETag" type="String">
      <label>GitHub Releases API ETag cache validator</label>
      <default></default>
    </entry>

    <entry name="CachedReleaseVersion" type="String">
      <label>Cached latest stable KDockW release version</label>
      <default></default>
    </entry>

    <entry name="CachedReleaseUrl" type="String">
      <label>Cached latest stable KDockW release URL</label>
      <default></default>
    </entry>

    <entry name="LastNotifiedReleaseVersion" type="String">
      <label>Latest release version already announced to the user</label>
      <default></default>
    </entry>

    <entry name="ReleaseApiRetryAfter" type="String">
      <label>GitHub API rate limit retry time</label>
      <default></default>
    </entry>

    <entry name="Language" type="String">
      <label>Interface language</label>
      <default>system</default>
    </entry>

    <entry name="IconSize" type="Int">
      <label>Icon size in pixels</label>
      <default>40</default>
      <min>24</min>
      <max>96</max>
    </entry>

    <entry name="IconSpacing" type="Int">
      <label>Spacing between icons</label>
      <default>10</default>
      <min>0</min>
      <max>64</max>
    </entry>

    <entry name="ContentPaddingLeft" type="Int">
      <label>Left content padding in logical pixels</label>
      <default>8</default>
      <min>0</min>
      <max>64</max>
    </entry>

    <entry name="ContentPaddingRight" type="Int">
      <label>Right content padding in logical pixels</label>
      <default>8</default>
      <min>0</min>
      <max>64</max>
    </entry>

    <entry name="ContentPaddingTop" type="Int">
      <label>Top content padding in logical pixels</label>
      <default>8</default>
      <min>0</min>
      <max>64</max>
    </entry>

    <entry name="ContentPaddingBottom" type="Int">
      <label>Bottom content padding in logical pixels</label>
      <default>0</default>
      <min>0</min>
      <max>64</max>
    </entry>

    <entry name="ContentAlignment" type="Int">
      <label>Dock content alignment (0=Start, 1=Center, 2=End)</label>
      <default>1</default>
      <min>0</min>
      <max>2</max>
    </entry>

    <entry name="IconOpacity" type="Double">
      <label>Icon opacity</label>
      <default>1.0</default>
      <min>0.5</min>
      <max>1.0</max>
    </entry>

    <!-- Legacy settings retained for config and downgrade compatibility.
         Dock rendering no longer reads any of these values. -->
    <entry name="IconOpacityActive" type="Double">
      <label>Icon opacity for the active window</label>
      <default>1.0</default>
      <min>0.1</min>
      <max>1.0</max>
    </entry>

    <entry name="IconOpacityInactive" type="Double">
      <label>Icon opacity for inactive windows and launchers</label>
      <default>1.0</default>
      <min>0.1</min>
      <max>1.0</max>
    </entry>

    <entry name="IconOpacityMinimized" type="Double">
      <label>Icon opacity for minimized windows</label>
      <default>1.0</default>
      <min>0.1</min>
      <max>1.0</max>
    </entry>

    <entry name="MaxZoomFactor" type="Double">
      <label>Maximum parabolic zoom factor</label>
      <default>1.9</default>
      <min>1.0</min>
      <max>2.0</max>
    </entry>

    <entry name="ZoomStyle" type="Int">
      <label>How magnified icons make room (0=Parabolic, 1=InPlace)</label>
      <default>0</default>
      <min>0</min>
      <max>1</max>
    </entry>

    <entry name="MagnificationMode" type="Int">
      <label>Icon magnification behavior (0=Classic, 1=Spring)</label>
      <default>1</default>
      <min>0</min>
      <max>1</max>
    </entry>

    <entry name="SpringStiffness" type="Double">
      <label>Spring magnification stiffness</label>
      <default>170.0</default>
      <min>20.0</min>
      <max>500.0</max>
    </entry>

    <entry name="SpringDamping" type="Double">
      <label>Spring magnification damping ratio</label>
      <default>0.60</default>
      <min>0.2</min>
      <max>1.5</max>
    </entry>

    <entry name="SpringSpeed" type="Double">
      <label>Spring magnification reaction speed</label>
      <default>0.9</default>
      <min>0.25</min>
      <max>3.0</max>
    </entry>

    <entry name="ZoomAnimationPreset" type="Int">
      <label>Zoom animation preset (0=Natural, 1=Quick, 2=Relaxed, 3=Instant, 4=Custom)</label>
      <default>0</default>
      <min>0</min>
      <max>4</max>
    </entry>

    <entry name="ZoomInDuration" type="Int">
      <label>Custom zoom-in duration in milliseconds at normal animation speed</label>
      <default>180</default>
      <min>0</min>
      <max>1000</max>
    </entry>

    <entry name="ZoomOutDuration" type="Int">
      <label>Custom zoom-out duration in milliseconds at normal animation speed</label>
      <default>240</default>
      <min>0</min>
      <max>1000</max>
    </entry>

    <entry name="ZoomInEasing" type="Int">
      <label>Custom zoom-in easing (0=Linear, 1=Ease in, 2=Ease out, 3=Ease in and out, 4=Gentle ease in and out)</label>
      <default>3</default>
      <min>0</min>
      <max>4</max>
    </entry>

    <entry name="ZoomOutEasing" type="Int">
      <label>Custom zoom-out easing (0=Linear, 1=Ease in, 2=Ease out, 3=Ease in and out, 4=Gentle ease in and out)</label>
      <default>3</default>
      <min>0</min>
      <max>4</max>
    </entry>

    <entry name="IconNormalization" type="Bool">
      <label>Normalize icon sizes by removing internal padding</label>
      <default>true</default>
    </entry>

    <entry name="IconScale" type="Double">
      <label>Icon scale within the allocated cell (1.0 = fill, smaller = more padding)</label>
      <default>1.0</default>
      <min>0.5</min>
      <max>1.0</max>
    </entry>

    <entry name="CornerRadius" type="Int">
      <label>Panel corner radius</label>
      <default>17</default>
      <min>0</min>
      <max>24</max>
    </entry>

    <entry name="Floating" type="Bool">
      <label>Whether the dock floats above the screen edge</label>
      <default>true</default>
    </entry>

    <entry name="FloatingMargin" type="Int">
      <label>Gap between the floating dock and the screen edge or an adjacent panel (px)</label>
      <default>3</default>
      <min>1</min>
      <max>32</max>
    </entry>

    <entry name="WindowGap" type="Int">
      <label>Gap between the dock and maximized windows (px)</label>
      <default>0</default>
      <min>0</min>
      <max>20</max>
    </entry>

    <entry name="VisibilityMode" type="Int">
      <label>Dock visibility mode (0=Always, 1=AutoHide, 2=Dodge)</label>
      <default>0</default>
    </entry>

    <entry name="ReserveScreenSpace" type="Bool">
      <label>Reserve screen space for the dock and window gap</label>
      <default>true</default>
    </entry>

    <entry name="DodgeActiveOnly" type="Bool">
      <label>Only dodge the active window (false = dodge all overlapping windows)</label>
      <default>true</default>
    </entry>

    <entry name="Edge" type="Int">
      <label>Screen edge (0=Top, 1=Bottom, 2=Left, 3=Right)</label>
      <default>1</default>
    </entry>

    <entry name="ShowDelay" type="Int">
      <label>Delay before showing dock (ms)</label>
      <default>200</default>
    </entry>

    <entry name="HideDelay" type="Int">
      <label>Delay before hiding dock (ms)</label>
      <default>500</default>
      <min>0</min>
      <max>2000</max>
    </entry>

    <entry name="DockShowHideAnimationEnabled" type="Bool">
      <label>Animate dock show and hide</label>
      <default>true</default>
    </entry>

    <entry name="DockShowHideAnimationDuration" type="Int">
      <label>Dock show and hide animation duration (ms)</label>
      <default>220</default>
      <min>100</min>
      <max>600</max>
    </entry>

    <entry name="BackgroundOpacity" type="Double">
      <label>Background opacity</label>
      <default>0.85</default>
      <min>0.0</min>
      <max>1.0</max>
    </entry>

    <entry name="BackgroundStyle" type="Int">
      <label>Background style (0=PanelInherit, 1=Transparent, 2=Tinted, 3=Acrylic)</label>
      <default>2</default>
      <min>0</min>
      <max>3</max>
    </entry>

    <entry name="UseAccentColor" type="Bool">
      <label>Use accent/selection color instead of header color for background</label>
      <default>false</default>
    </entry>

    <entry name="UseSystemColor" type="Bool">
      <label>Use system header color for Tinted style instead of custom tint color</label>
      <default>false</default>
    </entry>

    <entry name="TintColor" type="String">
      <label>Custom tint color for Tinted style (hex RGB)</label>
      <default>#4b4144</default>
    </entry>

    <entry name="ShadowEnabled" type="Bool">
      <label>Enable drop shadow behind the dock panel</label>
      <default>true</default>
    </entry>

    <entry name="ShadowLightX" type="Int">
      <label>Light source X position relative to panel center</label>
      <default>65</default>
      <min>-300</min>
      <max>300</max>
    </entry>

    <entry name="ShadowLightY" type="Int">
      <label>Light source Y position relative to panel center (negative=above)</label>
      <default>-132</default>
      <min>-300</min>
      <max>300</max>
    </entry>

    <entry name="ShadowLightZ" type="Int">
      <label>Light source height above screen surface</label>
      <default>500</default>
      <min>100</min>
      <max>2000</max>
    </entry>

    <entry name="ShadowLightRadius" type="Double">
      <label>Light source radius (controls shadow softness)</label>
      <default>5.5</default>
      <min>0.5</min>
      <max>20.0</max>
    </entry>

    <entry name="ShadowColor" type="String">
      <label>Shadow color (hex ARGB)</label>
      <default>#80000000</default>
    </entry>

    <entry name="ShadowIntensity" type="Double">
      <label>Shadow intensity (opacity)</label>
      <default>0.2</default>
      <min>0.0</min>
      <max>1.0</max>
    </entry>

    <entry name="ShadowElevation" type="Int">
      <label>Panel elevation above screen surface (for shadow projection)</label>
      <default>1</default>
      <min>1</min>
      <max>50</max>
    </entry>

    <entry name="PreviewEnabled" type="Bool">
      <label>Enable window preview on hover</label>
      <default>true</default>
    </entry>

    <entry name="CpuOnlyPreviewCapture" type="Bool">
      <label>Use CPU-compatible window preview capture</label>
      <default>false</default>
    </entry>

    <entry name="PreviewThumbnailSize" type="Int">
      <label>Preview thumbnail width</label>
      <default>320</default>
      <min>120</min>
      <max>320</max>
    </entry>

    <entry name="PreviewMaximumHeight" type="Int">
      <label>Maximum preview thumbnail height</label>
      <default>200</default>
      <min>80</min>
      <max>300</max>
    </entry>

    <entry name="PreviewCardPadding" type="Int">
      <label>Preview card inner padding</label>
      <default>8</default>
      <min>4</min>
      <max>24</max>
    </entry>

    <entry name="PreviewDockGap" type="Int">
      <label>Gap between preview card and dock</label>
      <default>2</default>
      <min>0</min>
      <max>32</max>
    </entry>

    <entry name="PreviewHoverDelay" type="Int">
      <label>Delay before showing preview (ms)</label>
      <default>500</default>
    </entry>

    <entry name="ActivateWindowOnExternalDrag" type="Bool">
      <label>Activate a running window when an external drag hovers over its task</label>
      <default>true</default>
    </entry>

    <entry name="ExternalDragActivationDelay" type="Int">
      <label>Delay before activating a window during an external drag (ms)</label>
      <default>700</default>
      <min>300</min>
      <max>1500</max>
    </entry>

    <entry name="PreviewHideDelay" type="Int">
      <label>Delay before hiding preview (ms)</label>
      <default>400</default>
      <min>0</min>
      <max>1500</max>
    </entry>

    <entry name="SingleWindowClickAction" type="Int">
      <label>Single window click action</label>
      <default>0</default>
      <min>0</min>
      <max>1</max>
    </entry>

    <entry name="GroupedWindowClickAction" type="Int">
      <label>Grouped window click action</label>
      <default>0</default>
      <min>0</min>
      <max>2</max>
    </entry>

    <entry name="AttentionAnimation" type="Int">
      <label>Attention animation style (0=None, 1=Bounce, 2=Wiggle, 3=Pulse, 4=Glow, 5=DotColor, 6=Blink)</label>
      <default>2</default>
      <min>0</min>
      <max>6</max>
    </entry>

    <entry name="LaunchBounceEnabled" type="Bool">
      <label>Animate application launches</label>
      <default>true</default>
    </entry>

    <entry name="LaunchBounceIntensity" type="Int">
      <label>Launch bounce height (percent of icon size)</label>
      <default>150</default>
      <min>50</min>
      <max>200</max>
    </entry>

    <entry name="ClickBounceEnabled" type="Bool">
      <label>Show a bounce when activating an open app</label>
      <default>true</default>
    </entry>

    <entry name="LaunchBounceSpeed" type="Int">
      <label>Launch bounce speed (percent)</label>
      <default>70</default>
      <min>50</min>
      <max>150</max>
    </entry>

    <entry name="AttentionAnimationEnabled" type="Bool">
      <label>Animate apps that demand attention</label>
      <default>true</default>
    </entry>

    <entry name="AttentionAnimationIntensity" type="Int">
      <label>Attention animation intensity (percent)</label>
      <default>100</default>
      <min>50</min>
      <max>150</max>
    </entry>

    <entry name="AttentionAnimationDuration" type="Int">
      <label>Duration of attention animation in seconds (0 = infinite)</label>
      <default>3</default>
      <min>0</min>
      <max>60</max>
    </entry>

    <entry name="RunningIndicatorStyle" type="Int">
      <label>Running application indicator style (0=Dot, 1=Line, 2=Pill, 3=Glow, 4=Bar)</label>
      <default>0</default>
      <min>0</min>
      <max>4</max>
    </entry>

    <entry name="RunningIndicatorPosition" type="Int">
      <label>Running application indicator position (0=ScreenEdge, 1=DockInterior)</label>
      <default>0</default>
      <min>0</min>
      <max>1</max>
    </entry>

    <entry name="RunningIndicatorSize" type="Int">
      <label>Running application indicator size in logical pixels</label>
      <default>4</default>
      <min>2</min>
      <max>12</max>
    </entry>

    <entry name="RunningIndicatorColorMode" type="Int">
      <label>Running application indicator color mode (0=Theme, 1=Custom)</label>
      <default>1</default>
      <min>0</min>
      <max>1</max>
    </entry>

    <entry name="RunningIndicatorColor" type="String">
      <label>Custom running application indicator color</label>
      <default>#ffffffff</default>
    </entry>

    <entry name="BadgeDisplayMode" type="Int">
      <label>Badge display mode (0=Number, 1=Dot, 2=Off)</label>
      <default>0</default>
      <min>0</min>
      <max>2</max>
    </entry>

    <entry name="BadgeBackgroundColor" type="String">
      <label>Notification badge background color</label>
      <default>#ffff3b30</default>
    </entry>

    <entry name="BadgeTextColor" type="String">
      <label>Notification badge text color</label>
      <default>#ffffffff</default>
    </entry>

    <entry name="BadgeFontWeight" type="Int">
      <label>Notification badge text weight</label>
      <default>500</default>
      <min>400</min>
      <max>700</max>
    </entry>

    <entry name="BadgeTextSizePercent" type="Int">
      <label>Notification badge text size percentage</label>
      <default>100</default>
      <min>75</min>
      <max>125</max>
    </entry>

    <entry name="MonitorMode" type="Int">
      <label>Monitor mode (0=PrimaryOnly, 1=AllScreens, 2=FollowActive, 3=SelectedScreens)</label>
      <default>0</default>
      <min>0</min>
      <max>3</max>
    </entry>

    <entry name="SelectedOutputs" type="StringList">
      <label>Output names selected for SelectedScreens monitor mode</label>
      <default></default>
    </entry>

    <entry name="FollowActiveTrigger" type="Int">
      <label>Follow active trigger (0=Mouse, 1=Focus, 2=Composite)</label>
      <default>1</default>
      <min>0</min>
      <max>2</max>
    </entry>

    <entry name="ScreenTransition" type="Int">
      <label>Screen transition animation (0=Fade, 1=Slide, 2=Instant)</label>
      <default>0</default>
      <min>0</min>
      <max>2</max>
    </entry>

    <entry name="VirtualDesktopMode" type="Int">
      <label>Virtual desktop display mode (0=ShowAll, 1=DimOtherDesktops, 2=CurrentOnly)</label>
      <default>1</default>
      <min>0</min>
      <max>2</max>
    </entry>

    <entry name="OtherDesktopOpacity" type="Double">
      <label>Opacity for windows on other virtual desktops (DimOtherDesktops mode)</label>
      <default>0.4</default>
      <min>0.1</min>
      <max>0.9</max>
    </entry>

    <entry name="PinnedLaunchers" type="StringList">
      <label>Pinned launcher URLs</label>
      <default>applications:org.kde.dolphin.desktop,applications:org.kde.konsole.desktop,applications:org.kde.kate.desktop,applications:systemsettings.desktop</default>
    </entry>

    <entry name="DockEntries" type="String">
      <label>Versioned typed dock entry order</label>
      <default></default>
    </entry>

    <entry name="SeparateLaunchers" type="Bool">
      <label>Separate pinned and running applications</label>
      <default>true</default>
    </entry>
  </group>
</kcfg>
